meta {
  name: Reply to a comment
  type: http
  seq: 4
}

post {
  url: {{host}}/comments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "content": "brilliant!",
    "requestId": "{{requestId}}",
    "parentId": "{{commentId}}",
    "replyingTo": "ladygaga"
  }
}
