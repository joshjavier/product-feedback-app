meta {
  name: Add a comment to a request
  type: http
  seq: 2
}

post {
  url: {{host}}/comments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "content": "cool cool cool",
    "requestId": "{{requestId}}"
  }
}

vars:post-response {
  commentId: res.body._id
}
